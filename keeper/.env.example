# Arc Testnet RPC URL
NODE_ENV=development
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Optional comma-separated fallback RPC URLs used when the primary endpoint rate-limits.
ARC_TESTNET_RPC_FALLBACK_URLS=https://rpc.testnet.arc.io
ARC_RPC_TIMEOUT_MS=15000
ARC_RPC_RETRY_COUNT=2
# Recommended for production keeper stability under RPC rate limiting.
KEEPER_TX_RETRY_MAX_ATTEMPTS=7
SCHEDULER_SIMULATION_BACKOFF_MS=30000
KEEPER_TX_CONFIRM_MAX_ATTEMPTS=8
KEEPER_TX_CONFIRM_RETRY_DELAY_MS=4000
KEEPER_TX_RECEIPT_TIMEOUT_MS=10000
KEEPER_SYNC_CONFIRMATION_IN_HOT_PATH=false
KEEPER_HEALTH_PORT=8787
# Queue mode switch:
# - true  => BullMQ + Redis (recommended for production)
# - false => direct execution in cron process (no Redis dependency)
KEEPER_USE_REDIS_QUEUE=true
KEEPER_SIMULATION_ESTIMATE_GAS=false
APP_KIT_DCA_GUARDRAIL_BYPASS=false
ENABLE_UNIFIED_BALANCE=false
ENABLE_GATEWAY_FORWARDER=false
CIRCLE_CLIENT_KEY=
CIRCLE_CLIENT_URL=
GATEWAY_API_BASE_URL=https://gateway-api-testnet.circle.com/
GATEWAY_TRANSFER_PATH=/v1/transfers

# Keeper HTTP API security
# In production this should remain true and a strong token must be configured.
KEEPER_API_REQUIRE_AUTH=true
KEEPER_API_AUTH_TOKEN=
# Comma-separated CORS allowlist. Avoid wildcard origins in production.
KEEPER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Per-IP request budget for protected routes (/recipes/* and /metrics)
KEEPER_API_RATE_LIMIT_WINDOW_MS=60000
KEEPER_API_RATE_LIMIT_MAX_REQUESTS=120
# Defense-in-depth internal-only path protection (ingress/reverse-proxy should still enforce this)
KEEPER_INTERNAL_ONLY_ENFORCED=true
KEEPER_INTERNAL_ONLY_PATHS=/healthz,/metrics

# DCA swap route provider on Arc Testnet
# Supported:
# - ARC_LIFI_SWAP (default, aliases: LIFI_SWAP, LIFI)
# - ARC_APP_KIT_SWAP (aliases: APP_KIT_SWAP, APP_KIT)
# To use App Kit swap flow from https://docs.arc.io/app-kit/swap,
# set DCA_ROUTE_PROVIDER=APP_KIT_SWAP (or ARC_APP_KIT_SWAP).
DCA_ROUTE_PROVIDER=ARC_LIFI_SWAP
# Optional LI.FI settings
LIFI_INTEGRATOR=defirecipes
# LI.FI API key to reduce anonymous/public rate-limit throttling on quote requests.
LIFI_API_KEY=
LIFI_API_BASE_URL=
# Optional fallback to Arc App Kit when LI.FI quote request fails
DCA_ROUTE_ALLOW_APP_KIT_FALLBACK=false
# App Kit swap settings (used when DCA_ROUTE_PROVIDER is App Kit,
# or fallback is enabled)
# Preferred names follow Arc docs terminology (API key/base URL),
# legacy names are still supported for backward compatibility.
ARC_APP_KIT_SWAP_BASE_URL=https://api.circle.com
ARC_APP_KIT_KEY=
ARC_APP_KIT_API_BASE_URL=
ARC_APP_KIT_API_KEY=

# Optional helper values for smoke/probe/verification scripts.
KEEPER_BASE_URL=http://localhost:8787
SMOKE_USER_ADDRESS=
SMOKE_LOG_LIMIT=5
PIPELINE_RUN_CLEANUP=true
PIPELINE_CLEANUP_ON_FAILURE=true
DCA_USER_ADDRESS=
DCA_TOTAL_BUDGET_USDC=2
DCA_PROBE_AMOUNTS=0.5,1
DCA_PROBE_SLIPPAGES=50,100
DCA_PROBE_TARGETS=EURC,cirBTC
DCA_TX_HASH=
DCA_PROXY_ADDRESS=
DCA_USDC_ADDRESS=0x3600000000000000000000000000000000000000
DCA_OUTPUT_TOKEN_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
DCA_RPC_URL=https://rpc.testnet.arc.network
DCA_USDC_DECIMALS=6
DCA_OUTPUT_DECIMALS=6
DCA_EXPECT_SWEEP_EVENT=true
KEEPER_METRICS_URL=http://localhost:8787/metrics
CLEANUP_USER_ADDRESS=

ALERT_CRON_CYCLE_P95_MS=1500
ALERT_RPC_CALLS_PER_CYCLE_P95=150
ALERT_SIM_RATE_LIMIT_FAILURE_RATE=0.08
ALERT_ENQUEUE_TO_SUBMITTED_P95_MS=2500
ALERT_ENQUEUE_TO_CONFIRMED_P95_MS=5000

# Keeper Wallet Private Key
KEEPER_PRIVATE_KEY=

# Database Connection (PostgreSQL)
# Use matching credentials for local PostgreSQL service or Docker instance
DATABASE_URL="postgresql://recipes_admin:recipes_password@localhost:5432/postgres?schema=recipes"
DB_SCHEMA=recipes

# Redis Connection URL
REDIS_URL=redis://localhost:6379
REDIS_RETRY_MAX_DELAY_MS=10000

# Deployed Contract Addresses on Arc Testnet (Chain ID 5042002)
SESSION_KEY_REGISTRY_ADDRESS=0x6d588749fef454ad088aee53d78cc020238a7d13
RECIPE_GUARDRAIL_ADDRESS=0xcf0dc13ab3d1efd2eac8baf47639f45b205ad824
SHARED_EXECUTOR_PROXY_ADDRESS=0xcbd2de404cb02c45b8688883e4321f887a6f2fc2
AUTO_COMPOUNDER_LENDING_BORROWING_ADDRESS=0x6cB6eE2a33F497C1a682657f15A874dc675Fa773
